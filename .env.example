# Google Form that backs the contact page. Responses land in the Form's linked
# Google Sheet. See scripts/contact-form-setup.md for how to find these values.

# The form's submit endpoint, ending in /formResponse (not /viewform).
GOOGLE_FORM_URL=

# Field IDs from the form's pre-filled link, e.g. entry.123456789
GOOGLE_FORM_ENTRY_NAME=
GOOGLE_FORM_ENTRY_EMAIL=
GOOGLE_FORM_ENTRY_PHONE=
GOOGLE_FORM_ENTRY_SUBJECT=
GOOGLE_FORM_ENTRY_MESSAGE=
